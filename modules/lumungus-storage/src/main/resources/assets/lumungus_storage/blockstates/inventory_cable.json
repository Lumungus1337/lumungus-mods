{
  "multipart": [
    { "apply": { "model": "lumungus_storage:block/pipe_center" } },
    { "when": { "north": "true" }, "apply": { "model": "lumungus_storage:block/pipe_connection_north" } },
    { "when": { "east": "true" }, "apply": { "model": "lumungus_storage:block/pipe_connection_north", "y": 90 } },
    { "when": { "south": "true" }, "apply": { "model": "lumungus_storage:block/pipe_connection_north", "y": 180 } },
    { "when": { "west": "true" }, "apply": { "model": "lumungus_storage:block/pipe_connection_north", "y": 270 } },
    { "when": { "up": "true" }, "apply": { "model": "lumungus_storage:block/pipe_connection_north", "x": 270 } },
    { "when": { "down": "true" }, "apply": { "model": "lumungus_storage:block/pipe_connection_north", "x": 90 } }
  ]
}
